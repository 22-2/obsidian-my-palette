{
	"name": "obsidian-my-palette",
	"version": "0.1.0",
	"description": "A VS Code-style palette for Obsidian: find files first, then decide how to open or act on them. Optional Everything 1.5a search.",
	"keywords": [
		"command-palette",
		"everything",
		"obsidian"
	],
	"license": "MIT",
	"author": "My Palette",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"build": "node esbuild.config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "pnpm exec tsc6 --noEmit",
		"lint": "eslint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:coverage:e2e": "node scripts/e2e-coverage.mjs",
		"test:coverage:combined": "pnpm test:coverage && pnpm test:coverage:e2e && node scripts/merge-coverage.mjs",
		"e2e": "node node_modules/electron/install.js && pnpm build && node e2e/prepare-plugin.mjs && playwright test",
		"ui:shots": "node scripts/screenshots/capture-screenshots.mjs",
		"prepare": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@tanstack/table-core": "^9.2.4",
		"consola": "^3.4.2",
		"fuzzysort": "^3.1.0",
		"idb": "^8.0.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@obsidian-typings/obsidian-public-latest": "^6.20.0",
		"@playwright/test": "^1.63.0",
		"@types/node": "26.1.0",
		"@vitest/coverage-v8": "5.0.3",
		"electron": "^44.6.0",
		"esbuild": "^0.28.2",
		"eslint": "10.12.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"happy-dom": "^20.14.5",
		"jiti": "2.7.0",
		"lint-staged": "^17.6.0",
		"obsidian": "^1.13.1",
		"obsidian-e2e-toolkit": "github:22-2/obsidian-e2e-toolkit#1848400d6d60b4a8e46a3c3c55a38fe4b8364438",
		"oxfmt": "^0.72.0",
		"playwright": "^1.63.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.71.1",
		"vitest": "^5.0.3"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		}
	}
}
