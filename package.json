{
	"name": "obsidian-my-palette",
	"version": "0.1.0",
	"description": "Keyboard-first command palette for Obsidian with Everything 1.5a search.",
	"keywords": [
		"command-palette",
		"everything",
		"obsidian"
	],
	"license": "MIT",
	"author": "My Palette",
	"main": "main.js",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "pnpm exec tsc --noEmit",
		"prepare": "vp config"
	},
	"dependencies": {
		"@tanstack/table-core": "^9.2.4",
		"consola": "^3.4.2",
		"fuzzysort": "^3.1.0",
		"idb": "^8.0.3"
	},
	"devDependencies": {
		"@obsidian-typings/obsidian-public-latest": "^6.20.0",
		"@types/node": "26.1.0",
		"happy-dom": "^20.14.5",
		"obsidian": "^1.13.1",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "download"
		}
	}
}
