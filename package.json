{
	"name": "obsidian-my-palette",
	"version": "0.2.0",
	"description": "A VS Code-style palette for Obsidian: find files first, then decide how to open or act on them. Optional Everything 1.5a search.",
	"keywords": [
		"command-palette",
		"everything",
		"obsidian"
	],
	"license": "MIT",
	"author": "My Palette",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"build": "node esbuild.config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "pnpm exec tsc6 --noEmit",
		"lint": "eslint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:coverage:e2e": "node scripts/e2e-coverage.mjs",
		"test:coverage:combined": "pnpm test:coverage && pnpm test:coverage:e2e && node scripts/merge-coverage.mjs",
		"e2e": "node node_modules/electron/install.js && pnpm build && node e2e/prepare-plugin.mjs && pnpm run test:e2e",
		"test:e2e": "pnpx offstage-windows playwright test",
		"test:e2e:smoke": "pnpm e2e smoke.spec.mts",
		"ui:shots": "node scripts/screenshots/capture-screenshots.mjs",
		"prepare": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@22-2/obsidian-magical-editor": "1.0.20",
		"@tanstack/table-core": "^9.3.1",
		"consola": "^3.4.2",
		"fuzzysort": "^4.0.2",
		"idb": "^8.0.4",
		"picomatch": "^4.0.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@obsidian-typings/obsidian-public-latest": "^6.59.0",
		"@playwright/test": "^1.65.0",
		"@types/node": "26.6.6",
		"@types/picomatch": "^4.0.3",
		"@vitest/coverage-v8": "5.1.0",
		"electron": "^45.3.0",
		"esbuild": "^0.28.2",
		"eslint": "10.14.0",
		"eslint-plugin-obsidianmd": "0.5.1",
		"globals": "17.14.0",
		"happy-dom": "^21.0.4",
		"jiti": "2.7.0",
		"lint-staged": "^17.6.0",
		"obsidian": "^1.14.4",
		"obsidian-e2e-toolkit": "https://github.com/22-2/obsidian-e2e-toolkit/releases/download/2.0.1/obsidian-e2e-toolkit-2.0.1.tgz",
		"oxfmt": "^0.78.0",
		"playwright": "^1.65.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.72.2",
		"vitest": "^5.1.0"
	},
	"lint-staged": {
		"*": "node node_modules/oxfmt/bin/oxfmt --no-error-on-unmatched-pattern"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		}
	}
}
