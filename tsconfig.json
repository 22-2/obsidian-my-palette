{
	"compilerOptions": {
		// Project structure
		"paths": { "*": ["./*"] },

		// Module system
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Type checking
		"strict": true,
		"skipLibCheck": true,

		// Type definitions
		"types": ["@obsidian-typings/obsidian-public-latest", "node"],
		"lib": ["DOM", "ESNext"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts"],
	"exclude": ["node_modules"]
}
